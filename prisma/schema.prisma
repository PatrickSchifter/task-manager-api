generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String @id @default(uuid())
  name            String
  email           String @unique
  password        String
  avatar          String?
  role            Role @default(USER)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createProjects  Project[] @relation("UserProjects")
  tasksAssigned   Task[]    @relation("AssignedTasks")
  comments        Comment[]
  collaborations  ProjectCollaborator[]
  chatMessages    ChatMessage[]
  tags            Tag[]     @relation("UserTags")
}

enum CollaboratorRole {
  VIEWER
  EDITOR
  OWNER
}

model ProjectCollaborator {
  id              String @id @default(uuid())
  role            CollaboratorRole @default(EDITOR)
  projectId       String
  userId          String

  createdAt       DateTime @default(now())

  user            User @relation(fields: [userId], references: [id])
  project         Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model Comment {
  id        String @id @default(uuid())
  content   String
  authorId  String
  taskId    String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User @relation(fields: [authorId], references: [id])
  task      Task @relation(fields: [taskId], references: [id])
}

model Project {
  id              String   @id @default(uuid())
  name            String
  description     String?
  createdById     String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks           Task[]
  createdBy       User @relation("UserProjects", fields: [createdById], references: [id])
  collaborators   ProjectCollaborator[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id            String @id @default(uuid())
  title         String
  description   String?
  status        TaskStatus @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  dueDate       DateTime?
  projectId     String
  assigneeId    String?
  // Fractional index key (ordenação lexicográfica). A coluna usa COLLATE "C"
  // no banco para que a ordenação por bytes case com a das chaves geradas.
  order         String @default("a0")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project @relation(fields: [projectId], references: [id])
  assignee      User? @relation("AssignedTasks", fields: [assigneeId], references: [id])
  comments      Comment[]
  tags          TaskTag[]

  @@unique([projectId, status, order])
}

// Tags são globais por usuário (catálogo do dono), reutilizadas entre projetos.
model Tag {
  id        String @id @default(uuid())
  name      String
  // Token de cor (ver src/utils/tag-color.ts): brand | emerald | amber | rose
  // | violet | cyan | muted. Atribuído automaticamente na criação.
  color     String
  ownerId   String

  createdAt DateTime @default(now())

  owner     User @relation("UserTags", fields: [ownerId], references: [id])
  tasks     TaskTag[]

  @@unique([ownerId, name])
}

// Join N:N entre Task e Tag. Cascade nos dois lados: apagar a task ou a tag
// remove o vínculo automaticamente.
model TaskTag {
  taskId String
  tagId  String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

enum TaskPriority {
  LOW 
  MEDIUM
  HIGH
}

enum EmbeddingSourceType {
  TASK
  COMMENT
  PROJECT
}

model Embedding {
  id         String              @id @default(uuid())
  sourceType EmbeddingSourceType
  sourceId   String
  content    String
  vector     Unsupported("vector(1536)")?
  metadata   Json                @default("{}")
  createdAt  DateTime            @default(now())

  @@index([sourceType, sourceId])
  @@unique([sourceType, sourceId])
}

enum MessageStatus {
  QUEUED
  PROCESSING
  DELIVERED
  FAILED
}

model ChatMessage {
  id        String        @id @default(uuid())
  userId    String
  content   String        @db.Text
  response  String?       @db.Text
  status    MessageStatus @default(QUEUED)
  filters   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
