generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String @id @default(uuid())
  name            String
  email           String @unique
  // Opcional: usuários que entram via Google não possuem senha local.
  password        String?
  googleId        String? @unique
  avatar          String?
  role            Role @default(USER)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createProjects  Project[] @relation("UserProjects")
  tasksAssigned   Task[]    @relation("AssignedTasks")
  comments        Comment[]
  collaborations  ProjectCollaborator[]
  chatMessages    ChatMessage[]
  tags            Tag[]        @relation("UserTags")
  attachments     Attachment[] @relation("UploadedAttachments")
  routines        Routine[]    @relation("UserRoutines")
}

enum CollaboratorRole {
  VIEWER
  EDITOR
  OWNER
}

model ProjectCollaborator {
  id              String @id @default(uuid())
  role            CollaboratorRole @default(EDITOR)
  projectId       String
  userId          String

  createdAt       DateTime @default(now())

  user            User @relation(fields: [userId], references: [id])
  project         Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model Comment {
  id        String @id @default(uuid())
  content   String
  authorId  String
  taskId    String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author      User         @relation(fields: [authorId], references: [id])
  task        Task         @relation(fields: [taskId], references: [id])
  attachments Attachment[]
}

model Project {
  id              String   @id @default(uuid())
  name            String
  description     String?
  createdById     String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks           Task[]
  createdBy       User @relation("UserProjects", fields: [createdById], references: [id])
  collaborators   ProjectCollaborator[]
  statuses        ProjectStatus[]
}

model ProjectStatus {
  id        String   @id @default(uuid())
  name      String
  value     String
  order     Int
  projectId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, value])
  @@index([projectId])
}

model Task {
  id            String @id @default(uuid())
  title         String
  description   String?
  status        String @default("TODO")
  priority      TaskPriority @default(MEDIUM)
  dueDate       DateTime?
  projectId     String
  assigneeId    String?
  // Subtarefa: auto-relação 1 nível. `parentId` null = tarefa top-level.
  // A regra de "1 nível" (uma subtarefa não pode ter subtarefas) é validada na
  // aplicação (TasksService); o banco só garante a integridade do vínculo.
  parentId      String?
  // Fractional index key (ordenação lexicográfica). A coluna usa COLLATE "C"
  // no banco para que a ordenação por bytes case com a das chaves geradas.
  order         String @default("a0")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project @relation(fields: [projectId], references: [id])
  assignee      User? @relation("AssignedTasks", fields: [assigneeId], references: [id])
  // onDelete: Cascade → apagar a tarefa-pai apaga as subtarefas no próprio banco.
  parent        Task? @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks      Task[] @relation("Subtasks")
  comments      Comment[]
  tags          TaskTag[]
  attachments   Attachment[]

  // Ordenação fracionária é escopada por (projectId, status, parentId): cada
  // "coluna" de subtarefas de um pai tem seu próprio espaço de `order`. O índice
  // usa NULLS NOT DISTINCT (ver migration) para manter a garantia também no
  // nível top-level (parentId = null), que o Postgres trataria como distinto.
  @@unique([projectId, status, parentId, order])
  @@index([parentId])
}

// Tags são globais por usuário (catálogo do dono), reutilizadas entre projetos.
model Tag {
  id        String @id @default(uuid())
  name      String
  // Token de cor (ver src/utils/tag-color.ts): brand | emerald | amber | rose
  // | violet | cyan | muted. Atribuído automaticamente na criação.
  color     String
  ownerId   String

  createdAt DateTime @default(now())

  owner     User @relation("UserTags", fields: [ownerId], references: [id])
  tasks     TaskTag[]

  @@unique([ownerId, name])
}

// Join N:N entre Task e Tag. Cascade nos dois lados: apagar a task ou a tag
// remove o vínculo automaticamente.
model TaskTag {
  taskId String
  tagId  String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

enum TaskPriority {
  LOW 
  MEDIUM
  HIGH
}

enum EmbeddingSourceType {
  TASK
  COMMENT
  PROJECT
  ATTACHMENT
  ROUTINE
}

model Embedding {
  id         String              @id @default(uuid())
  sourceType EmbeddingSourceType
  sourceId   String
  content    String
  vector     Unsupported("vector(1536)")?
  metadata   Json                @default("{}")
  chunkIndex Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([sourceType, sourceId])
  @@unique([sourceType, sourceId, chunkIndex])
}

enum StorageProvider {
  CLOUDINARY
  SUPABASE
}

enum AttachmentStatus {
  PENDING
  PROCESSING
  EMBEDDED
  FAILED
}

model Attachment {
  id           String           @id @default(uuid())
  fileName     String
  mimeType     String
  size         Int
  provider     StorageProvider
  storageKey   String
  url          String?
  status       AttachmentStatus @default(PENDING)
  taskId       String
  commentId    String?
  uploadedById String

  createdAt    DateTime         @default(now())

  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("UploadedAttachments", fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([commentId])
}

// Rotinas: atividades pessoais recorrentes (ex.: "Tomar água") que se repetem
// todos os dias em vários horários fixos. Estrutura separada de Task de
// propósito: rotina pertence ao usuário (não a um projeto), não participa do
// kanban/ordenação fracionária e o "concluído" é por (horário, dia) — um
// registro em RoutineCompletion — em vez de um status terminal na entidade.
model Routine {
  id          String  @id @default(uuid())
  title       String
  description String?
  // Pausa a rotina sem perder o histórico de conclusões.
  active      Boolean @default(true)
  // Dias da semana em que a rotina está ativa (0=Dom … 6=Sáb).
  // Array vazio [] significa "todos os dias" (padrão para compatibilidade retroativa).
  days        Int[]   @default([])
  ownerId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User          @relation("UserRoutines", fields: [ownerId], references: [id], onDelete: Cascade)
  times RoutineTime[]

  @@index([ownerId])
}

// Um bloco de tempo do dia em que a rotina deve ser executada (ex.: 08:00–09:00).
model RoutineTime {
  id        String @id @default(uuid())
  // Horário de início e fim no formato HH:mm (24h), validados na aplicação.
  startTime String
  endTime   String
  routineId String

  routine     Routine             @relation(fields: [routineId], references: [id], onDelete: Cascade)
  completions RoutineCompletion[]

  @@unique([routineId, startTime])
}

// Marca que um horário da rotina foi cumprido num determinado dia. O unique
// (routineTimeId, date) faz o "concluir" ser idempotente por dia.
model RoutineCompletion {
  id            String   @id @default(uuid())
  routineTimeId String
  // Dia (sem hora) da conclusão.
  date          DateTime @db.Date

  createdAt DateTime @default(now())

  routineTime RoutineTime @relation(fields: [routineTimeId], references: [id], onDelete: Cascade)

  @@unique([routineTimeId, date])
}

enum MessageStatus {
  QUEUED
  PROCESSING
  DELIVERED
  FAILED
}

model ChatMessage {
  id        String        @id @default(uuid())
  userId    String
  content   String        @db.Text
  response  String?       @db.Text
  status    MessageStatus @default(QUEUED)
  filters   Json?
  actions   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
