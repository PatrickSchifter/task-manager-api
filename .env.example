#Database
DATABASE_URL="url"

#JWT
JWT_SECRET=secret

#Mail
RESEND_API_KEY=re_7...
EMAIL_FROM=no.reply@...

#RMQ
RABBITMQ_URL=url

#Cloudnary
CLOUDNARY_CLOUD_NAME=name
CLOUDNARY_API_KEY=key
CLOUDNARY_API_SECRET=secret

#App
PORT=some_number
URL_BASE=urlbase
WEB_APP_URL_BASE=web_app_url
NODE_ENV=development

#Google OAuth
# Credenciais do OAuth Client ID (Web application) criado no Google Cloud Console.
#
# No console do Google, configure os "URIs de redirecionamento autorizados"
# (eles precisam bater EXATAMENTE com GOOGLE_CALLBACK_URL abaixo):
#   - Dev:  http://localhost:3030/v1/auth/google/callback
#   - Prod: https://tasks-api.solutlabs.com.br/v1/auth/google/callback
#
# "Origens JavaScript autorizadas" NÃO são necessárias neste fluxo (o handshake
# é feito no backend, não no browser). Se quiser preencher mesmo assim, use só a
# origem (sem path):
#   - Dev:  http://localhost:3000  e  http://localhost:3030
#   - Prod: https://app.solutlabs.com.br  e  https://tasks-api.solutlabs.com.br
GOOGLE_CLIENT_ID=client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=client_secret

# Dev:
GOOGLE_CALLBACK_URL=http://localhost:3030/v1/auth/google/callback
# Prod (descomente em produção e ajuste o domínio real da API):
# GOOGLE_CALLBACK_URL=https://tasks-api.solutlabs.com.br/v1/auth/google/callback